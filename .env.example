# Filled in by scripts/deploy.mjs after a studionet deploy, then read by
# scripts/build.mjs to bake the address into the frontend.
GENLAYER_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CITEGUARD_ADDRESS

# The deployer private key is NOT stored here. It is loaded from the central
# keystore at deploy time:  source ~/.genlayer/env.sh
